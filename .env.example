# Copy this file to `.env` and fill in the values. Never commit `.env`.

# PostgreSQL connection string.
# Hosted databases usually need SSL: add `?sslmode=require` to the URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yellowlime

# Claude API key (https://console.anthropic.com) for profiles and articles.
ANTHROPIC_API_KEY=

# Semrush API key (Semrush → Subscription info → API units).
SEMRUSH_API_KEY=

# How Semrush is reached:
#   mcp  – via the Semrush MCP server (default). Works with Semrush One
#          Starter / Pro+ and SEO Classic Pro / Guru, which include API units.
#   api  – the classic Semrush API. Requires the Business plan + API units.
SEMRUSH_MODE=mcp

# Optional settings
# PORT=8080
# LOG_LEVEL=info
# SEMRUSH_MCP_URL=https://mcp.semrush.com/v2/mcp
# Only needed when the web app is hosted on a different domain than the API:
# CORS_ORIGIN=https://studio.example.com
