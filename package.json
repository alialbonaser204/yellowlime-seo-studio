{
  "name": "yellowlime-seo-studio",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @yellowlime/api --filter @yellowlime/web run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "start": "pnpm --filter @yellowlime/api run start",
    "test": "pnpm --filter @yellowlime/api run test",
    "db:migrate": "pnpm --filter @yellowlime/db run migrate",
    "db:generate": "pnpm --filter @yellowlime/db run generate",
    "db:push": "pnpm --filter @yellowlime/db run push",
    "codegen": "pnpm --filter @yellowlime/api-spec run codegen",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./apps/**\" --if-present run typecheck",
    "cf:build": "node -e \"process.exit(process.env.DATABASE_URL ? 0 : 1)\" && pnpm db:migrate || echo 'DATABASE_URL ontbreekt: migraties overgeslagen'; pnpm --filter @yellowlime/web run build",
    "cf:dev": "pnpm --filter @yellowlime/web run build && wrangler dev",
    "cf:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "wrangler": "^4.162.0"
  }
}
